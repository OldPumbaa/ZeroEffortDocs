{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--bin", "zed"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUST_BACKTRACE": "1"
        }
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cargo: test",
      "type": "process",
      "command": "cargo",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": "test"
    }
  ]
}

{
  // F5 / Run and Debug — штатный запуск (сборка + сервер + отладчик).
  // Ctrl+F5 — то же без брейкпоинтов.
  // Ctrl+Shift+B только компилирует, сервер не поднимает.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ZED",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/zed.exe",
      "args": ["--no-open"],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "RUST_LOG", "value": "zed=debug,tower_http=info" },
        { "name": "RUST_BACKTRACE", "value": "1" }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "cargo: build"
    },
    {
      "name": "ZED + браузер",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/zed.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "RUST_LOG", "value": "zed=debug,tower_http=info" },
        { "name": "RUST_BACKTRACE", "value": "1" }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "cargo: build"
    }
  ]
}
